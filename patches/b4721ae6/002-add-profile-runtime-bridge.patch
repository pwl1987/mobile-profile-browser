diff --git a/apps/weblibre/android/app/src/main/kotlin/eu/weblibre/gecko/runtime/RuntimeBridgePlugin.kt b/apps/weblibre/android/app/src/main/kotlin/eu/weblibre/gecko/runtime/RuntimeBridgePlugin.kt
