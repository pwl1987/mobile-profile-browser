+package eu.weblibre.gecko.runtime
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import eu.weblibre.flutter_mozilla_components.api.GeckoProfileApiImpl
+import eu.weblibre.flutter_mozilla_components.startup.StartupArbiter
+import io.flutter.embedding.engine.FlutterEngine
+import io.flutter.plugin.common.MethodCall
+import io.flutter.plugin.common.MethodChannel
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * Mobile Profile Runtime Bridge（patches/b4721ae6/002-add-profile-runtime-bridge.patch）。
+ *
+ * Binder 只是 Android/WebLibre 的执行适配层（ADR-007 边界）：
+ * - bind/unbind 薄转发上游 GeckoProfileApi（armProfileRestart /
+ *   completeProfileRestart），不重新实现生命周期控制；
+ * - health 为**过渡实现**：probeKind = "binding_presence"（StartupArbiter
+ *   提交 + 绑定目录存在），**不是 Gecko runtime 心跳**；B.3 真机阶段必须
+ *   升级为真实 Gecko 探测（probeKind = "gecko_runtime"）后，alive 才能
+ *   代表运行时存活。bindingPresent 与 runtimeAlive 在协议中显式区分，
+ *   不允许伪装。
+ * - 禁止运行时 rebind：目标与当前提交不同时，唯一出路是
+ *   armProfileRestart（persistNextStartProfile + trampoline + alarm），
+ *   返回 restart_required 由上层编排进程重启。
+ *
+ * 会话身份（sessionId/generation）是执行层单值内存状态，不是数据库：
+ * - bind 成功（本进程已提交目标）时记录；
+ * - 进程重启后丢失 → health 返回空身份 → Dart 侧 fail-closed 判死；
+ * - 新进程在 bootstrap 提交核验后必须经 attachSessionIdentity 重建身份
+ *   （核验条件：StartupArbiter.committedProfileId == 目标），否则
+ *   "Gecko 启动成功但 Dart 判死"。这是 B.3 真机验收的前置链路。
+ */
+object RuntimeBridgePlugin {
+    private const val CHANNEL = "weblibre/runtime_bridge"
+    private const val PROBE_KIND = "binding_presence"
+
+    @Volatile private var identitySessionId: String? = null
+    @Volatile private var identityGeneration: Int? = null
+
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    fun register(context: Context, flutterEngine: FlutterEngine) {
+        val appContext = context.applicationContext
+        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, CHANNEL)
+            .setMethodCallHandler { call, result ->
+                try {
+                    when (call.method) {
+                        "bind" -> handleBind(appContext, call, result)
+                        "unbind" -> handleUnbind(appContext, call, result)
+                        "health" -> handleHealth(call, result)
+                        "attachSessionIdentity" -> handleAttachIdentity(call, result)
+                        else -> result.notImplemented()
+                    }
+                } catch (t: Throwable) {
+                    result.error("bridge_error", t.message ?: t.javaClass.simpleName, null)
+                }
+            }
+    }
+
+    private fun handleBind(
+        appContext: Context,
+        call: MethodCall,
+        result: MethodChannel.Result,
+    ) {
+        val target = stringArg(call, "browserProfileId").lowercase()
+        val sessionId = stringArg(call, "sessionId")
+        val generation = intArg(call, "generation")
+
+        val committed = StartupArbiter.committedProfileId()
+        if (committed != null && committed.equals(target, ignoreCase = true)) {
+            adoptIdentity(sessionId, generation)
+            result.success(
+                mapOf(
+                    "result" to "bound",
+                    "targetProfile" to target,
+                    "pid" to Process.myPid(),
+                )
+            )
+            return
+        }
+
+        // 上游无运行时 rebind：目标 ≠ 当前提交，唯一出路是重启切换。
+        val armed = GeckoProfileApiImpl(appContext)
+            .armProfileRestart(target, "mobile_profile_switch")
+        if (armed) {
+            result.success(
+                mapOf(
+                    "result" to "restart_required",
+                    "currentProfile" to committed,
+                    "targetProfile" to target,
+                    "sessionId" to sessionId,
+                    "generation" to generation,
+                )
+            )
+        } else {
+            result.error(
+                "arm_failed",
+                "RestartCoordinator refused the restart (state=${StartupArbiter.currentState()})",
+                null,
+            )
+        }
+    }
+
+    private fun handleUnbind(
+        appContext: Context,
+        call: MethodCall,
+        result: MethodChannel.Result,
+    ) {
+        val target = stringArg(call, "browserProfileId").lowercase()
+        val committed = StartupArbiter.committedProfileId()
+        if (committed == null || !committed.equals(target, ignoreCase = true)) {
+            result.error(
+                "not_bound",
+                "process is not committed to $target (committed=$committed)",
+                null,
+            )
+            return
+        }
+
+        // P0 顺序约束（B.2-b 硬 Gate）：必须先完成 {result: exiting} 应答，
+        // 再 exitProcess(0)。result.success() 在主线程同步写出应答字节；
+        // terminate 投递到主线程队列末尾，保证应答先于进程退出送达。
+        // 该顺序是 B.3 真机集成测试的必测点（Dart await 不得悬挂）。
+        result.success(mapOf("result" to "exiting"))
+        mainHandler.post {
+            GeckoProfileApiImpl(appContext).completeProfileRestart()
+        }
+    }
+
+    private fun handleHealth(call: MethodCall, result: MethodChannel.Result) {
+        val expected = stringArg(call, "browserProfileId").lowercase()
+        val committed = StartupArbiter.committedProfileId()
+        val boundFolder = StartupArbiter.boundProfileFolder()
+
+        val bindingPresent = committed != null &&
+            committed.equals(expected, ignoreCase = true) &&
+            boundFolder != null
+
+        val payload = mutableMapOf<String, Any?>(
+            // 过渡实现：alive == bindingPresent，probeKind 明示非心跳。
+            "bindingPresent" to bindingPresent,
+            "probeKind" to PROBE_KIND,
+            "alive" to bindingPresent,
+            "browserProfileId" to expected,
+            "observedAt" to isoNow(),
+            "pid" to Process.myPid(),
+        )
+        if (bindingPresent) {
+            payload["sessionId"] = identitySessionId
+            payload["generation"] = identityGeneration
+        }
+        result.success(payload)
+    }
+
+    private fun handleAttachIdentity(call: MethodCall, result: MethodChannel.Result) {
+        val target = stringArg(call, "browserProfileId").lowercase()
+        val sessionId = stringArg(call, "sessionId")
+        val generation = intArg(call, "generation")
+
+        val committed = StartupArbiter.committedProfileId()
+        if (committed == null || !committed.equals(target, ignoreCase = true)) {
+            // 拒绝伪造：身份必须与 native 提交事实一致才可注入。
+            result.success(
+                mapOf(
+                    "adopted" to false,
+                    "reason" to "committed=$committed does not match $target",
+                )
+            )
+            return
+        }
+        adoptIdentity(sessionId, generation)
+        result.success(mapOf("adopted" to true))
+    }
+
+    private fun adoptIdentity(sessionId: String, generation: Int) {
+        identitySessionId = sessionId
+        identityGeneration = generation
+    }
+
+    private fun stringArg(call: MethodCall, key: String): String =
+        call.argument<String>(key)
+            ?: throw IllegalArgumentException("missing argument: $key")
+
+    private fun intArg(call: MethodCall, key: String): Int =
+        call.argument<Int>(key)
+            ?: throw IllegalArgumentException("missing argument: $key")
+
+    private fun isoNow(): String =
+        SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US)
+            .apply { timeZone = TimeZone.getTimeZone("UTC") }
+            .format(Date())
+}

