+import 'package:flutter/services.dart';
+import 'package:mobile_profile_weblibre/mobile_profile_weblibre.dart';
+
+/// `WebLibreRuntimeBridgeChannel` 的物理 MethodChannel 实现
+/// （patches/b4721ae6/002-add-profile-runtime-bridge.patch 载体）。
+///
+/// 协议对端是 Android 侧 `RuntimeBridgePlugin`（bind/unbind/health/
+/// attachSessionIdentity）。任何协议异常（missing field / wrong type /
+/// unknown result / channel error）都以
+/// [PlatformException]/[WebLibreRuntimeBridgeError] 形式上抛，
+/// 由上层 fail-closed 处理——本层不做任何兜底重试或默认值。
+final class MethodChannelRuntimeBridge implements WebLibreRuntimeBridgeChannel {
+  MethodChannelRuntimeBridge({MethodChannel? channel})
+      : _channel = channel ?? const MethodChannel('weblibre/runtime_bridge');
+
+  final MethodChannel _channel;
+
+  @override
+  Future<Map<String, Object?>> bind({
+    required String browserProfileId,
+    required String profileDir,
+    required String sessionId,
+    required int generation,
+  }) async {
+    final raw = await _channel.invokeMethod<Map<dynamic, dynamic>>('bind', <String, Object?>{
+      'browserProfileId': browserProfileId,
+      'profileDir': profileDir,
+      'sessionId': sessionId,
+      'generation': generation,
+    });
+    return _asMap(raw, 'bind');
+  }
+
+  @override
+  Future<Map<String, Object?>> unbind({
+    required String browserProfileId,
+    required String sessionId,
+    required int generation,
+  }) async {
+    final raw = await _channel.invokeMethod<Map<dynamic, dynamic>>('unbind', <String, Object?>{
+      'browserProfileId': browserProfileId,
+      'sessionId': sessionId,
+      'generation': generation,
+    });
+    return _asMap(raw, 'unbind');
+  }
+
+  @override
+  Future<Map<String, Object?>> health({required String browserProfileId}) async {
+    final raw = await _channel.invokeMethod<Map<dynamic, dynamic>>(
+      'health',
+      <String, Object?>{'browserProfileId': browserProfileId},
+    );
+    return _asMap(raw, 'health');
+  }
+
+  /// 新进程 bootstrap 提交核验后重建会话身份（B.3 真机验收前置链路）。
+  /// 返回 adopted=false 表示 native 提交与目标不一致，身份被拒绝。
+  Future<bool> attachSessionIdentity({
+    required String browserProfileId,
+    required String sessionId,
+    required int generation,
+  }) async {
+    final raw =
+        await _channel.invokeMethod<Map<dynamic, dynamic>>(
+      'attachSessionIdentity',
+      <String, Object?>{
+        'browserProfileId': browserProfileId,
+        'sessionId': sessionId,
+        'generation': generation,
+      },
+    );
+    final map = _asMap(raw, 'attachSessionIdentity');
+    return map['adopted'] == true;
+  }
+
+  static Map<String, Object?> _asMap(Object? raw, String method) {
+    if (raw is Map) {
+      return Map<String, Object?>.from(raw);
+    }
+    throw WebLibreRuntimeBridgeError('$method 返回了非对象负载: $raw');
+  }
+}

