+package eu.weblibre.gecko.runtime
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import android.util.Log
+import eu.weblibre.flutter_mozilla_components.EngineProvider
+import eu.weblibre.flutter_mozilla_components.GeckoRuntimeState
+import eu.weblibre.flutter_mozilla_components.api.GeckoProfileApiImpl
+import eu.weblibre.flutter_mozilla_components.startup.StartupArbiter
+import eu.weblibre.flutter_mozilla_components.startup.StartupState
+import io.flutter.embedding.engine.FlutterEngine
+import io.flutter.plugin.common.MethodCall
+import io.flutter.plugin.common.MethodChannel
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * Mobile Profile Runtime Bridge（patches/b4721ae6/002-add-profile-runtime-bridge.patch）。
+ *
+ * Binder 只是 Android/WebLibre 的执行适配层（ADR-007 边界）：
+ * - bind/unbind 薄转发上游 GeckoProfileApi（armProfileRestart /
+ *   completeProfileRestart），不重新实现生命周期控制；
+ * - health 为真实 Gecko 探测（B.3 Gate）：probeKind = "gecko_runtime"，
+ *   runtimeAlive 来自 EngineProvider.runtimeState()（Live/NeverCreated/
+ *   Shutdown，与 StartupArbiter 独立的第二事实源，Live.profileId 交叉
+ *   核验目标）；alive = bindingPresent && runtimeAlive，缺一不可。
+ *   bindingPresent 仍作为独立诊断字段返回（Arbiter 提交 + 绑定目录）。
+ * - 禁止运行时 rebind：目标与当前提交不同时，唯一出路是
+ *   armProfileRestart（persistNextStartProfile + trampoline + alarm），
+ *   返回 restart_required 由上层编排进程重启。
+ *
+ * 会话身份（sessionId/generation）是执行层单值内存状态，不是数据库：
+ * - bind 成功（本进程已提交目标）时记录；
+ * - 进程重启后丢失 → health 返回空身份 → Dart 侧 fail-closed 判死；
+ * - 新进程在 bootstrap 提交核验后必须经 attachSessionIdentity 重建身份
+ *   （核验条件：StartupArbiter.committedProfileId == 目标），否则
+ *   "Gecko 启动成功但 Dart 判死"。这是 B.3 真机验收的前置链路。
+ *
+ * 取证（B.3）：除 logcat（TAG=MobileProfileBridge）外，全部操作同步追加
+ * 到应用私有文件 b3-bridge.log（超限轮转），供 adb pull 导出；
+ * selfCheck / readLogTail / clearLog 是只读/诊断通道，不改变任何状态机。
+ */
+object RuntimeBridgePlugin {
+    private const val CHANNEL = "weblibre/runtime_bridge"
+    private const val TAG = "MobileProfileBridge"
+    private const val LOG_FILE_NAME = "b3-bridge.log"
+    private const val LOG_FILE_MAX_BYTES = 5L * 1024 * 1024
+    private const val LOG_TAIL_MAX_CHARS = 100_000
+
+    /**
+     * health 探测（B.3 Gate）：
+     * - bindingPresent：StartupArbiter 提交 + 绑定目录（"系统认为已绑定"）；
+     * - runtimeAlive：EngineProvider.runtimeState() 的真实 Gecko 状态
+     *   （Live/NeverCreated/Shutdown）——B3-12 的判别器：Arbiter COMMITTED
+     *   而 Gecko 已 Shutdown/NeverCreated 时，alive 必须为 false；
+     * - probeKind 恒为 gecko_runtime（真机前如需回退诊断模式，
+     *   bindingPresent 字段仍独立可读）；
+     * - alive = bindingPresent && runtimeAlive（缺一不可）。
+     */
+    @Volatile private var identitySessionId: String? = null
+    @Volatile private var identityGeneration: Int? = null
+
+    @Volatile private var appContextRef: Context? = null
+    private var logFileRef: File? = null
+
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    fun register(context: Context, flutterEngine: FlutterEngine) {
+        val appContext = context.applicationContext
+        appContextRef = appContext
+        val file = File(appContext.filesDir, LOG_FILE_NAME)
+        logFileRef = file
+        log("register pid=${Process.myPid()} logFile=${file.absolutePath}")
+        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, CHANNEL)
+            .setMethodCallHandler { call, result ->
+                try {
+                    when (call.method) {
+                        "bind" -> handleBind(appContext, call, result)
+                        "unbind" -> handleUnbind(appContext, call, result)
+                        "health" -> handleHealth(call, result)
+                        "attachSessionIdentity" -> handleAttachIdentity(call, result)
+                        "selfCheck" -> handleSelfCheck(result)
+                        "readLogTail" -> handleReadLogTail(call, result)
+                        "clearLog" -> handleClearLog(result)
+                        else -> result.notImplemented()
+                    }
+                } catch (t: Throwable) {
+                    result.error("bridge_error", t.message ?: t.javaClass.simpleName, null)
+                }
+            }
+    }
+
+    /**
+     * 文件日志：logcat 之外可导出的第二份证据。仅追加、仅诊断，
+     * 写失败不得影响协议（诊断 fail-open，协议 fail-closed）。
+     */
+    private fun log(message: String) {
+        Log.i(TAG, message)
+        val context = appContextRef ?: return
+        try {
+            synchronized(this) {
+                val file = logFileRef
+                    ?: File(context.filesDir, LOG_FILE_NAME).also { logFileRef = it }
+                if (file.length() > LOG_FILE_MAX_BYTES) {
+                    file.writeText("")
+                    Log.i(TAG, "log rotated (truncated) path=${file.absolutePath}")
+                }
+                file.appendText("[$message]\n")
+            }
+        } catch (t: Throwable) {
+            Log.w(TAG, "log file append failed: ${t.message}")
+        }
+    }
+
+    private fun handleBind(
+        appContext: Context,
+        call: MethodCall,
+        result: MethodChannel.Result,
+    ) {
+        val target = stringArg(call, "browserProfileId").lowercase()
+        val sessionId = stringArg(call, "sessionId")
+        val generation = intArg(call, "generation")
+
+        val committed = StartupArbiter.committedProfileId()
+        if (committed != null && committed.equals(target, ignoreCase = true)) {
+            adoptIdentity(sessionId, generation)
+            log(
+                "bind bound target=$target session=$sessionId gen=$generation " +
+                    "pid=${Process.myPid()} at=${isoNow()}",
+            )
+            result.success(
+                mapOf(
+                    "result" to "bound",
+                    "targetProfile" to target,
+                    "pid" to Process.myPid(),
+                )
+            )
+            return
+        }
+
+        // 上游无运行时 rebind：目标 ≠ 当前提交，唯一出路是重启切换。
+        val armed = GeckoProfileApiImpl(appContext)
+            .armProfileRestart(target, "mobile_profile_switch")
+        if (armed) {
+            log(
+                "bind restart_required target=$target current=$committed " +
+                    "session=$sessionId gen=$generation pid=${Process.myPid()} at=${isoNow()}",
+            )
+            result.success(
+                mapOf(
+                    "result" to "restart_required",
+                    "currentProfile" to committed,
+                    "targetProfile" to target,
+                    "sessionId" to sessionId,
+                    "generation" to generation,
+                )
+            )
+        } else {
+            log("bind arm_failed target=$target state=${StartupArbiter.currentState()}")
+            result.error(
+                "arm_failed",
+                "RestartCoordinator refused the restart (state=${StartupArbiter.currentState()})",
+                null,
+            )
+        }
+    }
+
+    private fun handleUnbind(
+        appContext: Context,
+        call: MethodCall,
+        result: MethodChannel.Result,
+    ) {
+        val target = stringArg(call, "browserProfileId").lowercase()
+        val committed = StartupArbiter.committedProfileId()
+        if (committed == null || !committed.equals(target, ignoreCase = true)) {
+            log("unbind rejected target=$target committed=$committed")
+            result.error(
+                "not_bound",
+                "process is not committed to $target (committed=$committed)",
+                null,
+            )
+            return
+        }
+
+        // P0 顺序约束（B.2-b 硬 Gate）：必须先完成 {result: exiting} 应答，
+        // 再 exitProcess(0)。result.success() 在主线程同步写出应答字节；
+        // terminate 投递到主线程队列末尾，保证应答先于进程退出送达。
+        // 该顺序是 B.3 真机集成测试的必测点（Dart await 不得悬挂）。
+        log(
+            "unbind exiting target=$target session=${call.argument<String>("sessionId")} " +
+                "gen=${call.argument<Int>("generation")} pid=${Process.myPid()} at=${isoNow()}",
+        )
+        result.success(mapOf("result" to "exiting"))
+        mainHandler.post {
+            log("unbind terminate pid=${Process.myPid()} at=${isoNow()}")
+            GeckoProfileApiImpl(appContext).completeProfileRestart()
+        }
+    }
+
+    private fun handleHealth(call: MethodCall, result: MethodChannel.Result) {
+        val expected = stringArg(call, "browserProfileId").lowercase()
+        val committed = StartupArbiter.committedProfileId()
+        val boundFolder = StartupArbiter.boundProfileFolder()
+
+        val bindingPresent = committed != null &&
+            committed.equals(expected, ignoreCase = true) &&
+            boundFolder != null
+
+        // 真实 Gecko 探测（B.3 Gate）：EngineProvider 维护的运行时状态
+        // 是与 Arbiter 独立的第二事实源；Live.profileId 交叉核验目标。
+        val gecko = EngineProvider.runtimeState()
+        val geckoStateName = geckoStateName(gecko)
+        val geckoProfileId = (gecko as? GeckoRuntimeState.Live)?.profileId
+        val runtimeAlive = gecko is GeckoRuntimeState.Live &&
+            gecko.profileId.equals(expected, ignoreCase = true)
+        val observedAt = isoNow()
+        val pid = Process.myPid()
+
+        val payload = mutableMapOf<String, Any?>(
+            "bindingPresent" to bindingPresent,
+            "probeKind" to "gecko_runtime",
+            "runtimeAlive" to runtimeAlive,
+            "geckoState" to geckoStateName,
+            "geckoProfileId" to geckoProfileId,
+            "alive" to (bindingPresent && runtimeAlive),
+            "browserProfileId" to expected,
+            "observedAt" to observedAt,
+            "pid" to pid,
+        )
+        if (bindingPresent) {
+            payload["sessionId"] = identitySessionId
+            payload["generation"] = identityGeneration
+        }
+        log(
+            "health expected=$expected committed=$committed binding=$bindingPresent " +
+                "gecko=$geckoStateName geckoProfile=$geckoProfileId alive=${payload["alive"]} " +
+                "session=$identitySessionId gen=$identityGeneration " +
+                "observedAt=$observedAt pid=$pid",
+        )
+        result.success(payload)
+    }
+
+    private fun handleAttachIdentity(call: MethodCall, result: MethodChannel.Result) {
+        val target = stringArg(call, "browserProfileId").lowercase()
+        val sessionId = stringArg(call, "sessionId")
+        val generation = intArg(call, "generation")
+
+        val committed = StartupArbiter.committedProfileId()
+        if (committed == null || !committed.equals(target, ignoreCase = true)) {
+            // 拒绝伪造：身份必须与 native 提交事实一致才可注入。
+            log("attachSessionIdentity rejected target=$target committed=$committed")
+            result.success(
+                mapOf(
+                    "adopted" to false,
+                    "reason" to "committed=$committed does not match $target",
+                )
+            )
+            return
+        }
+        adoptIdentity(sessionId, generation)
+        log(
+            "attachSessionIdentity adopted target=$target session=$sessionId " +
+                "gen=$generation pid=${Process.myPid()} at=${isoNow()}",
+        )
+        result.success(mapOf("adopted" to true))
+    }
+
+    /**
+     * 只读诊断快照（B.3 检查页）：聚合四个独立事实源，供真机取证与
+     * 交叉核验。不触发任何状态迁移。
+     */
+    private fun handleSelfCheck(result: MethodChannel.Result) {
+        val gecko = EngineProvider.runtimeState()
+        val geckoStateName = geckoStateName(gecko)
+        val geckoProfileId = (gecko as? GeckoRuntimeState.Live)?.profileId
+        val committed = StartupArbiter.committedProfileId()
+        val boundFolder = StartupArbiter.boundProfileFolder()
+        val arbiterState = StartupArbiter.currentState()
+        val arbiterStateText = startupStateDescription(arbiterState)
+        val file = logFileRef
+        val logSizeBytes = file?.let { if (it.exists()) it.length() else 0L } ?: 0L
+        val payload = mapOf(
+            "engineProviderState" to geckoStateName,
+            "engineProviderProfileId" to geckoProfileId,
+            "arbiterCommitted" to committed,
+            "arbiterBoundFolder" to boundFolder,
+            "arbiterState" to arbiterStateText,
+            "identitySessionId" to identitySessionId,
+            "identityGeneration" to identityGeneration,
+            "logFile" to file?.absolutePath,
+            "logSizeBytes" to logSizeBytes,
+            "appPid" to Process.myPid(),
+            "checkedAt" to isoNow(),
+        )
+        log(
+            "selfCheck gecko=$geckoStateName geckoProfile=$geckoProfileId " +
+                "committed=$committed boundFolder=$boundFolder arbiter=$arbiterStateText " +
+                "session=$identitySessionId gen=$identityGeneration logSize=$logSizeBytes " +
+                "pid=${Process.myPid()}",
+        )
+        result.success(payload)
+    }
+
+    /**
+     * 读取 b3-bridge.log 末尾 maxChars 个字符（诊断通道，只读）。
+     */
+    private fun handleReadLogTail(call: MethodCall, result: MethodChannel.Result) {
+        val maxChars = intArg(call, "maxChars").coerceIn(1, LOG_TAIL_MAX_CHARS)
+        val file = logFileRef
+        if (file == null || !file.exists()) {
+            log("readLogTail empty maxChars=$maxChars")
+            result.success(
+                mapOf(
+                    "text" to "",
+                    "totalBytes" to 0L,
+                    "truncated" to false,
+                    "path" to null,
+                )
+            )
+            return
+        }
+        val totalBytes = file.length()
+        val content = file.readText()
+        val text =
+            if (content.length > maxChars) content.substring(content.length - maxChars)
+            else content
+        val truncated = content.length > maxChars
+        log("readLogTail maxChars=$maxChars totalBytes=$totalBytes truncated=$truncated")
+        result.success(
+            mapOf(
+                "text" to text,
+                "totalBytes" to totalBytes,
+                "truncated" to truncated,
+                "path" to file.absolutePath,
+            )
+        )
+    }
+
+    private fun handleClearLog(result: MethodChannel.Result) {
+        val file = logFileRef
+        if (file != null && file.exists()) {
+            file.writeText("")
+        }
+        log("clearLog path=${file?.absolutePath}")
+        result.success(mapOf("cleared" to true))
+    }
+
+    private fun geckoStateName(gecko: GeckoRuntimeState): String = when (gecko) {
+        is GeckoRuntimeState.NeverCreated -> "never_created"
+        is GeckoRuntimeState.Live -> "live"
+        is GeckoRuntimeState.Shutdown -> "shutdown"
+    }
+
+    /**
+     * 把上游 `StartupState`（sealed interface）投影为 MethodChannel 可编码的
+     * 稳定诊断字符串。只读取事实字段，不触发任何仲裁副作用。
+     */
+    private fun startupStateDescription(state: StartupState): String = when (state) {
+        is StartupState.Uninitialized -> "uninitialized"
+        is StartupState.Unresolved ->
+            "unresolved(candidate=${state.candidateProfileId})"
+        is StartupState.Selecting ->
+            "selecting(lease=${state.leaseId}, candidate=${state.candidateProfileId})"
+        is StartupState.Committing -> "committing(profile=${state.profileId})"
+        is StartupState.Committed ->
+            "committed(profile=${state.profileId}, path=${state.relativePath})"
+        is StartupState.MaintenanceReserved ->
+            "maintenance_reserved(task=${state.taskId}, recovery=${state.recoveryRequired})"
+        is StartupState.Maintenance ->
+            "maintenance(task=${state.taskId}, recovery=${state.recoveryRequired})"
+        is StartupState.RestartPreparing ->
+            "restart_preparing(target=${state.targetProfileId}, reason=${state.reason})"
+        is StartupState.Restarting ->
+            "restarting(target=${state.targetProfileId}, reason=${state.reason})"
+    }
+
+    private fun adoptIdentity(sessionId: String, generation: Int) {
+        identitySessionId = sessionId
+        identityGeneration = generation
+    }
+
+    private fun stringArg(call: MethodCall, key: String): String =
+        call.argument<String>(key)
+            ?: throw IllegalArgumentException("missing argument: $key")
+
+    private fun intArg(call: MethodCall, key: String): Int =
+        call.argument<Int>(key)
+            ?: throw IllegalArgumentException("missing argument: $key")
+
+    private fun isoNow(): String =
+        SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US)
+            .apply { timeZone = TimeZone.getTimeZone("UTC") }
+            .format(Date())
+}
